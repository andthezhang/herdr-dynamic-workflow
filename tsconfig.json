{
  // Type-checking config: covers src AND tests so `npm run check` (tsc --noEmit)
  // catches type regressions in the suite too (tsx --test strips types without
  // checking them). Emit is done via tsconfig.build.json, which narrows back
  // to src/ so tests never land in dist/.
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
