{
  // Emit config for `npm run build`: src only (tests are type-checked by the
  // base tsconfig.json but must never be emitted into dist/).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true
  },
  "include": ["src/**/*.ts"]
}
